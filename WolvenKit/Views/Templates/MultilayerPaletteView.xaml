<UserControl
    x:Class="WolvenKit.Views.Editors.MultilayerPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="160">
    <!-- DataContext: the ChunkViewModel of a layer's colorScale in a multilayer setup -->
    <Expander
        x:Name="PaletteExpander"
        Margin="{DynamicResource WolvenKitMarginTiny}"
        Header="Palette"
        IsExpanded="True">
        <ScrollViewer
            MaxHeight="240"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <!-- one row per group of the template's colours, the group's base colour first -->
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>
    </Expander>
</UserControl>
