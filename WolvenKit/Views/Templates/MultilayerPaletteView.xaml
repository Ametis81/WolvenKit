<UserControl
    x:Class="WolvenKit.Views.Editors.MultilayerPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="160">
    <!-- DataContext: the ChunkViewModel of a layer's colorScale in a multilayer setup -->
    <StackPanel>
        <Expander
            x:Name="PaletteExpander"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            Header="Palette"
            IsExpanded="True">
            <StackPanel>
                <!-- the same palette two ways; the choice holds for all layers and files of the session -->
                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                    <RadioButton
                        x:Name="GridModeButton"
                        Content="Grid"
                        ToolTip="Each colour group is a column, its variants below the base colour, scrolling sideways (like CDPR's material browser)" />
                    <RadioButton
                        x:Name="RowsModeButton"
                        Margin="12,0,0,0"
                        Content="Rows"
                        ToolTip="Each colour group is a row, the rows wrapping down (like the Blender add-on)" />
                </StackPanel>

                <!-- one column per group, base colour on top; Shift + wheel scrolls sideways -->
                <ScrollViewer
                    x:Name="GridScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="GridScroll_OnPreviewMouseWheel">
                    <!-- bottom margin: the scroll bar sits below the swatches, not against them -->
                    <StackPanel
                        x:Name="ColumnsPanel"
                        Margin="0,0,0,8"
                        Orientation="Horizontal" />
                </ScrollViewer>

                <ScrollViewer
                    x:Name="RowsScroll"
                    MaxHeight="320"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!--
                        one block per group of the template's colours, the group's base colour first; the blocks are
                        as wide as the largest group and flow left to right, then down, in palette order
                    -->
                    <WrapPanel x:Name="RowsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- the layer's template path leads nowhere (mistyped, or the file was renamed or moved) -->
        <TextBlock
            x:Name="NotFoundText"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            Foreground="{DynamicResource WolvenKitOrange}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- only for templates that aren't the project's own yet -->
        <Button
            x:Name="CopyTemplateButton"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            HorizontalAlignment="Left"
            Content="Copy template to project..."
            ToolTip="Copy the layer's template into the project under a path of its own and point the layer to the copy, to add or change colours without changing the game's template"
            Click="CopyTemplateButton_OnClick" />
    </StackPanel>
</UserControl>
