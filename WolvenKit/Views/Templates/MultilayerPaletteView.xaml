<UserControl
    x:Class="WolvenKit.Views.Editors.MultilayerPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="320"
    d:DesignHeight="160">
    <!-- DataContext: the ChunkViewModel of a layer's colorScale in a multilayer setup -->
    <StackPanel>
        <Expander
            x:Name="PaletteExpander"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            Header="Palette"
            IsExpanded="True">
            <StackPanel>
                <!--
                    on the right, like the search box of the file editor: search, the switch between the two layouts
                    of the palette (the choice holds for all layers and files of the session) and the template copy
                -->
                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                    <!-- only for templates that aren't the project's own yet -->
                    <Button
                        x:Name="CopyTemplateButton"
                        Margin="8,0,0,0"
                        Content="Copy template to project..."
                        DockPanel.Dock="Right"
                        ToolTip="Copy the layer's template into the project under a path of its own and point the layer to the copy, to add or change colours without changing the game's template"
                        Click="CopyTemplateButton_OnClick" />

                    <!-- Grid ( O) Rows, a switch as the Mod Browser one of the asset browser; before the copy button -->
                    <StackPanel
                        Margin="8,0,0,0"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Text="Grid"
                            ToolTip="Each colour group is a column, its variants below the base colour, scrolling sideways (like CDPR's material browser)" />
                        <!-- MinWidth 0: the style's minimum width left a wide gap before "Rows" -->
                        <mah:ToggleSwitch
                            x:Name="ModeSwitch"
                            MinWidth="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            ToolTip="Grid: colour groups as columns (like CDPR's material browser). Rows: colour groups as rows (like the Blender add-on)"
                            Toggled="ModeSwitch_OnToggled" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Rows"
                            ToolTip="Each colour group is a row, the rows wrapping down (like the Blender add-on)" />
                    </StackPanel>

                    <!-- live filter (TextChanged), the search bar of the asset browser -->
                    <hc:SearchBar
                        x:Name="SearchBox"
                        Width="180"
                        VerticalAlignment="Center"
                        hc:InfoElement.Placeholder="Search, e.g. 48e702"
                        hc:InfoElement.ShowClearButton="True"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SearchBarPlus}"
                        ToolTip="Dims the colours whose name doesn't contain the text"
                        TextChanged="SearchBox_OnTextChanged" />
                </DockPanel>

                <!-- one column per group, base colour on top; Shift + wheel scrolls sideways -->
                <ScrollViewer
                    x:Name="GridScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="GridScroll_OnPreviewMouseWheel">
                    <!-- bottom margin: the scroll bar sits below the swatches, not against them -->
                    <StackPanel
                        x:Name="ColumnsPanel"
                        Margin="0,0,0,8"
                        Orientation="Horizontal" />
                </ScrollViewer>

                <ScrollViewer
                    x:Name="RowsScroll"
                    MaxHeight="320"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <!--
                        one block per group of the template's colours, the group's base colour first; the blocks are
                        as wide as the largest group and flow left to right, then down, in palette order
                    -->
                    <WrapPanel x:Name="RowsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- the layer's template path leads nowhere (mistyped, or the file was renamed or moved) -->
        <TextBlock
            x:Name="NotFoundText"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            Foreground="{DynamicResource WolvenKitOrange}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
